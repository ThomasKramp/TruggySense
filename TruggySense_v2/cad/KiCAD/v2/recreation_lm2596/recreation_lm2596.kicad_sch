	(text "V_{SAT} = 1.16V\nV_{D} = V_{F} = 0.525V\nE*T = (V_{IN} - V_{OUT} - V_{SAT})[(V_{OUT} + V_{D})/(V_{IN} - V_{SAT} + V_{D)}](1/150kHz)\n    = (5V - 3.3V - 1.16V)[(3.3V + 0.525V)/(5V - 1.16V + 0.525V)](1/150kHz)\n    = 0.54V * [3.825V/4.365V] * 6.667µs\n	= 3.15 V*µs\n\nThen get L1 out of figure9-8 (link attached)\nL1 = 15µH"
		(exclude_from_sim no)
		(at 90.424 64.262 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
			(href "https://www.ti.com/lit/ds/symlink/lm2596.pdf#%5B%7B%22num%22%3A389%2C%22gen%22%3A0%7D%2C%7B%22name%22%3A%22XYZ%22%7D%2Cnull%2C517.034%2Cnull%5D")
		)
		(uuid "2c029da7-a5da-4dd1-9fcf-bf468224d50e")
	)
	(text "V_{REF} = 1.23V\nV_{OUT} = V_{REF} * (1 + R2/R1)\nR2 = R1 * (V_{OUT}/V_{REF} - 1) = 1kΩ * (3.3V/1.23V - 1) = 1.68kΩ\nR2.1 = 1kΩ\nR2.2 = 0.68kΩ"
		(exclude_from_sim no)
		(at 90.424 47.498 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "760cec56-16d8-44f8-8285-171c05dac747")
	)
	(text "https://htckorea.co.kr/image/DK/LM2596_Module_R1.0.pdf"
		(exclude_from_sim no)
		(at 206.756 168.402 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(href "https://htckorea.co.kr/image/DK/LM2596_Module_R1.0.pdf")
		)
		(uuid "b5950833-1cdc-46fe-93fc-0b82e46374a5")
	)
	(text "C_{FF} = C3 = 1/(31 * 10^{3} * R2)\n     = 1/(31 * 10^{3} * 1.68kΩ)\n     = 19.2nF\n\nC3.1 = 33nF\nC3.2 = 47nF\nC3 = 1/[(1/C3.1)+(1/C3.2)]\n   = 1/[(1/33nF)+(1/47nF)]\n   = 19.388nF"
		(exclude_from_sim no)
		(at 90.17 85.598 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d19b7fb1-589c-4f1f-a886-792c7c985861")
	)
